{
  "name": "@zhoulvyuan/dsh-claude-code-web",
  "version": "0.2.0",
  "description": "DSH 插件：Claude Code 原生工作台（宿主内嵌 server.cjs 的 HTTP/WebSocket 面 + 客户端全局入口：侧边栏底部按钮 + shell.overlay 悬浮面板，跟随 DSH 主题；支持仅可查看/工作区内修改/完全权限三档权限模式）",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test state-poll.test.cjs test/*.test.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.241",
    "ws": "^8.21.0"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "server.cjs",
    "public/mermaid.min.js",
    "public/index.html",
    "public/react.production.min.js",
    "public/react-dom.production.min.js",
    "cordis.patch.yml",
    "DEPLOY.md",
    "state-poll.cjs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhoulvyuan/dsh-plugin.git",
    "directory": "dsh-claude-code-web"
  },
  "homepage": "https://github.com/zhoulvyuan/dsh-plugin/tree/master/dsh-claude-code-web",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "claude-code",
    "anthropic",
    "deepseek-harness"
  ]
}
